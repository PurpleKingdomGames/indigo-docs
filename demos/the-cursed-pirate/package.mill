package build.demos.`the-cursed-pirate`

import mill.*
import mill.scalalib.*
import mill.api.BuildCtx
import indigoplugin.*
import build.GameModule

object `package` extends GameModule:

  override def indigoAssets =
    Task.Source(BuildCtx.workspaceRoot / os.RelPath("demos/the-cursed-pirate/assets"))

  def indigoOptions(assetsDirectory: os.Path): IndigoOptions =
    makeIndigoOptions("The Cursed Pirate - Made with Indigo")
      .withWindowWidth(1280)
      .withWindowHeight(720)
      .withBackgroundColor("black")
      .excludeAssetPaths {
        case p if p.contains("unused")                       => true
        case p if p.contains("Captain Clown Nose Data.json") => true
      }
      .excludeAssets {
        case p if p.toString.endsWith(".DS_Store") => true
        case _                                     => false
      }

  override def indigoGenerators(assetsDirectory: os.Path): IndigoGenerators =
    IndigoGenerators("pirate.generated")
      .listAssets("Assets")
      .generateConfig("Config")
      .embedAseprite(
        "CaptainAnim",
        BuildCtx.workspaceRoot / "demos" / "the-cursed-pirate" / "assets" / "captain" / "Captain Clown Nose Data.json"
      )

  override def mvnDeps =
    super.mvnDeps() ++ Seq(mvn"org.scalacheck::scalacheck::1.15.3")
