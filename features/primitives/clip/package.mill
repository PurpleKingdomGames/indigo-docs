package build.features.primitives.clip

import mill.*
import mill.api.BuildCtx
import indigoplugin.*
import build.GameModule

object `package` extends GameModule:

  override def indigoAssets =
    Task.Source(BuildCtx.workspaceRoot / os.RelPath("features/primitives/clip/assets"))

  def indigoOptions(assetsDirectory: os.Path): IndigoOptions =
    makeIndigoOptions("Clip Example")
      .withWindowWidth(550)
      .withWindowHeight(400)
      .withBackgroundColor("black")

  override def indigoGenerators(assetsDirectory: os.Path): IndigoGenerators =
    IndigoGenerators("indigoexamples.generated")
      .listAssets("Assets")
      .generateConfig("Config")
